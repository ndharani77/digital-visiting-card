# PostgreSQL connection. Not required when using the local JSON store.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/digital_visiting_card

# Set a unique secret of at least 32 characters for production.
AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Used only when creating the initial production Super Admin.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters

# For local development only, set DEV_AUTH_BYPASS=true to skip sign-in.
# The app also requires NODE_ENV=development; never enable this in production.
DEV_AUTH_BYPASS=false

# Use "json" for local development or "postgres" for a PostgreSQL deployment.
STORAGE_DRIVER=json
